# ===== Основное =====
APP_NAME=B2B CRM
ENV=production
# Внешний адрес системы (используется в письмах, трекинге открытий, ссылках на КП)
PUBLIC_BASE_URL=http://localhost:8080
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ===== Секреты (ОБЯЗАТЕЛЬНО сгенерируйте свои) =====
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=replace-with-fernet-key

# ===== База данных =====
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm
BACKUP_KEEP_DAYS=30
BACKUP_HOUR=3

# ===== Файловое хранилище (S3-совместимое: MinIO, Yandex Object Storage) =====
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_BUCKET=crm-files
S3_REGION=us-east-1

# ===== Почта: отправка (SMTP) =====
# По умолчанию — тестовый Mailpit (http://localhost:8025). Для боевой работы укажите SMTP вашего домена.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAIL_FROM=CRM <crm@example.com>

# ===== Почта: приём заявок (IMAP, email-парсер лидов) =====
IMAP_ENABLED=false
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=sales@example.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ===== Telegram-бот для уведомлений =====
TELEGRAM_BOT_TOKEN=

# ===== Телефония (SIP-АТС) =====
# mock — демонстрационный режим; generic_http — вызов HTTP API АТС для click-to-call
TELEPHONY_PROVIDER=mock
TELEPHONY_API_URL=
TELEPHONY_API_TOKEN=
TELEPHONY_WEBHOOK_SECRET=change-me-telephony

# ===== Лимиты =====
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=10
WEB_WORKERS=4
